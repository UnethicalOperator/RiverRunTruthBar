<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>TruthBar.IL2CPP</AssemblyName>
    <RootNamespace>TruthBar</RootNamespace>
    <Version>2.2.0</Version>
    <Product>RiverRunTruthBar</Product>
    <Authors>PlsDntChase</Authors>
    <Company>PlsDntChase / RiverRunCartel</Company>
    <Description>RiverRunTruthBar IL2CPP overlay for Liar's Bar.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Liar's Bar</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx.Core" HintPath="$(GameDir)\BepInEx\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="BepInEx.Unity.IL2CPP" HintPath="$(GameDir)\BepInEx\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(GameDir)\BepInEx\core\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="Il2Cppmscorlib" HintPath="$(GameDir)\BepInEx\interop\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(GameDir)\BepInEx\interop\Assembly-CSharp.dll" Private="false" />
    <Reference Include="Mirror" HintPath="$(GameDir)\BepInEx\interop\Mirror.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameDir)\BepInEx\interop\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(GameDir)\BepInEx\interop\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(GameDir)\BepInEx\interop\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(GameDir)\BepInEx\interop\UnityEngine.TextRenderingModule.dll" Private="false" />
  </ItemGroup>

  <Target Name="VerifyGameReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(GameDir)\GameAssembly.dll')" Text="Liar's Bar was not found at $(GameDir). Pass -p:GameDir=&quot;path&quot;." />
    <Error Condition="!Exists('$(GameDir)\BepInEx\interop\Assembly-CSharp.dll')" Text="BepInEx IL2CPP interop files are missing. Run the game once with BepInEx installed before building." />
  </Target>
</Project>
